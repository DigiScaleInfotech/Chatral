# --- Live chat API ---
PORT=4100
NODE_ENV=production
# Separate database from the calendar app.
DATABASE_URL=postgresql://livechat:CHANGE_ME@localhost:5432/livechat
# Public URL of this API (widget script + websocket are served from here)
API_URL=https://chat.yourdomain.com
# Dashboard URL (same server by default: API_URL/admin)
ADMIN_URL=https://chat.yourdomain.com/admin
# 32+ random chars: openssl rand -hex 32
JWT_SECRET=
# 32 bytes hex - encrypts webhook secrets + store SMTP passwords at rest: openssl rand -hex 32
ENC_KEY=

# Attachments (private; never served statically). Back this up / put on a persistent volume.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Background workers (job queue + retention sweep). Set false on extra web replicas if you want.
RUN_WORKERS=true
RETENTION_SWEEP_MINUTES=60

# Platform SMTP fallback (stores can set their own in Settings → Notifications). Leave empty = no emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Live Chat <chat@yourdomain.com>"

# First super admin (npm run seed). Remove the password from the environment after seeding.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Dev only: password for scripts/seed-demo.js demo users
# DEMO_PASSWORD=

# Bitrix24 alert for each new chat / offline message (optional). The URL contains a secret: keep it only in .env.
# Base inbound-webhook URL (needs the "im" scope), e.g. https://yourportal.bitrix24.in/rest/<userId>/<secret>/
BITRIX24_WEBHOOK_URL=
# Bitrix24 user id that receives the message
BITRIX24_DIALOG_ID=

# Optional: Expo access token, only if "enhanced push security" is enabled in your Expo account.
# Server-only secret - never put it in the mobile app.
EXPO_ACCESS_TOKEN=
